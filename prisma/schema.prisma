// Prisma Şeması - Atölyem (Workshop & Kayıt Yönetim Sistemi)
// Neon PostgreSQL ve Next.js 16 ile tam uyumlu

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkshopStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
}

model Instructor {
  id        Int        @id @default(autoincrement())
  fullName  String
  specialty String
  email     String     @unique
  workshops Workshop[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([email])
}

model Workshop {
  id            Int                    @id @default(autoincrement())
  title         String
  description   String                 @db.Text
  startDate     DateTime
  quota         Int
  status        WorkshopStatus         @default(ACTIVE)
  instructorId  Int
  instructor    Instructor             @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  registrations WorkshopRegistration[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([instructorId])
}

model Participant {
  id            Int                    @id @default(autoincrement())
  fullName      String
  email         String                 @unique
  registrations WorkshopRegistration[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([email])
}

model WorkshopRegistration {
  id               Int                @id @default(autoincrement())
  workshopId       Int
  participantId    Int
  registrationDate DateTime           @default(now())
  status           RegistrationStatus @default(REGISTERED)
  workshop         Workshop           @relation(fields: [workshopId], references: [id], onDelete: Restrict)
  participant      Participant        @relation(fields: [participantId], references: [id], onDelete: Restrict)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([workshopId, participantId], name: "unique_workshop_participant")
  @@index([workshopId])
  @@index([participantId])
  @@index([status])
}
